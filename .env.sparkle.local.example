# Local Sparkle + Cloudflare release automation settings.
# Copy this file to: .env.sparkle.local
# Do not commit .env.sparkle.local.

# Release signing / notarization
LOOPBOX_RELEASE_IDENTITY="Developer ID Application: Your Name (TEAMID)"
LOOPBOX_NOTARY_PROFILE="loopbox-notary"

# Sparkle embedding / feed config
# Optional preferred path. Leave empty to auto-detect.
SPARKLE_FRAMEWORK_PATH=""
SPARKLE_PUBLIC_KEY="REPLACE_WITH_SPARKLE_PUBLIC_KEY"
SPARKLE_FEED_URL="https://updates.loopbox.tech/appcast.xml"
# Optional: true|false
SPARKLE_AUTO_CHECKS="true"
# Optional: true|false. If true, installs Sparkle via `brew install --cask sparkle` when missing.
AUTO_INSTALL_SPARKLE="true"
# Optional: true|false. If true, removes macOS quarantine from resolved Sparkle binaries/framework.
AUTO_CLEAR_SPARKLE_QUARANTINE="true"

# Local updater artifact workspace
# Keep this directory persistent across releases so generate_appcast can build deltas.
LOOPBOX_UPDATES_DIR=".updates/sparkle"
# Optional: true|false. If true, download existing updater history from R2 before publish.
SYNC_FROM_R2_BEFORE_PUBLISH="true"
# Optional: true|false. If true, delete local files missing from R2 during pre-sync.
R2_SYNC_DELETE_LOCAL_MISSING="false"

# Optional: path to release notes markdown/html for current release.
# Relative paths are resolved from repo root.
LOOPBOX_RELEASE_NOTES_FILE=""

# Optional preferred generate_appcast path. Leave empty to auto-detect.
LOOPBOX_GENERATE_APPCAST_BIN=""

# Optional: publish ZIP to GitHub Releases via release-macos.sh
PUBLISH_GITHUB_RELEASE="false"
# Optional: target repository when publishing from this workspace.
# Format: owner/repo
PUBLISH_GITHUB_RELEASE_REPO="cn0ss/loopbox"

# Cloudflare R2 (S3 API) upload settings
CLOUDFLARE_R2_ACCOUNT_ID="REPLACE_WITH_ACCOUNT_ID"
CLOUDFLARE_R2_BUCKET="loopbox-updates"
CLOUDFLARE_R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"

# Optional bucket prefix (no leading slash), e.g. "stable"
CLOUDFLARE_R2_PREFIX=""

# Optional explicit endpoint override.
# Default: https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=""

# Upload caching behavior
UPLOAD_APPCAST_CACHE_CONTROL="no-store, no-cache, must-revalidate, max-age=0"
UPLOAD_ASSET_CACHE_CONTROL="public, max-age=31536000, immutable"
UPLOAD_OTHER_CACHE_CONTROL="public, max-age=3600"

# Optional: purge Cloudflare cache for SPARKLE_FEED_URL after upload.
UPLOAD_PURGE_APPCAST="false"
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
